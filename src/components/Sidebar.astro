---
import { slugify } from '@/utils/slug';

interface Props {
	index: {
		[k: string]: string[];
	};
}

const { index } = Astro.props;
---

<aside
	id="site-sidebar"
	data-open="false"
	class="sticky top-0 flex h-screen w-72 shrink-0 flex-col overflow-y-auto bg-base p-10 max-sm:fixed max-sm:inset-y-0 max-sm:left-0 max-sm:z-40 max-sm:transition-transform"
>
	<a
		href="/#top"
		class="mb-12 text-3xl leading-tight font-bold tracking-wide text-primary uppercase"
	>
		MATIAS PEÑALOZA
	</a>

	<nav class="flex flex-col gap-10">
		{
			Object.entries(index).map(([name, sec]) => (
				<div class="flex flex-col">
					<a href={'#' + slugify(name)} class="mb-4 text-xl font-medium hover:text-primary">
						# {name}
					</a>
					<ul class="flex flex-col gap-3 pl-6">
						{sec.map((art) => (
							<li>
								<a href={'#' + slugify(art)} class="text-sm transition-colors hover:text-primary">
									- {art}
								</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</nav>

	<div class="mt-auto flex flex-col gap-4 pt-10 text-sm">
		<div class="flex items-center justify-between">
			<span class="text-xs tracking-widest text-content/70 uppercase">Theme</span>
			<div class="flex items-center gap-2">
				<button data-theme="dark" type="button" class="theme-option cursor-pointer tracking-wide uppercase">
					dark
				</button>
				<span class="text-content/50 pointer-events-none">|</span>
				<button data-theme="light" type="button" class="theme-option cursor-pointer tracking-wide uppercase">
					light
				</button>
			</div>
		</div>

		<div class="flex items-center justify-between">
			<span class="text-xs tracking-widest text-content/70 uppercase">Languaje</span>
			<div class="flex items-center gap-2">
				<button data-lang="es" type="button" class="lang-option cursor-pointer tracking-wide uppercase">
					es
				</button>
				<span class="text-content/50 pointer-events-none">|</span>
				<button data-lang="en" type="button" class="lang-option cursor-pointer tracking-wide uppercase">
					en
				</button>
			</div>
		</div>
	</div>
</aside>

<style>
	@media (max-width: 640px) {
		#site-sidebar[data-open='false'] {
			transform: translateX(-100%);
		}
		#site-sidebar[data-open='true'] {
			transform: translateX(0);
		}
	}
</style>

<script>
	const setActiveFromHash = () => {
		const hash = window.location.hash;
		const links = document.querySelectorAll('aside nav a[href^="#"]');
		links.forEach((link) => {
			if (link.getAttribute('href') === hash) {
				link.classList.add('text-primary');
			} else {
				link.classList.remove('text-primary');
			}
		});
	};

	const body = document.body;
	const themeOptions = document.querySelectorAll('button.theme-option');
	const langOptions = document.querySelectorAll('button.lang-option');

	const setActiveOption = (buttons: NodeListOf<Element>, value: string, attr: string) => {
		buttons.forEach((button) => {
			const isActive = button.getAttribute(attr) === value;
			button.classList.toggle('text-primary', isActive);
			button.classList.toggle('text-content/60', !isActive);
		});
	};

	const applyTheme = (theme: string) => {
		if (theme === 'light') {
			body.classList.add('light');
		} else {
			body.classList.remove('light');
		}
		setActiveOption(themeOptions, theme, 'data-theme');
	};

	const applyLang = (lang: string) => {
		setActiveOption(langOptions, lang, 'data-lang');
	};

	const savedTheme = localStorage.getItem('theme') || 'light';
	applyTheme(savedTheme);

	const savedLang = localStorage.getItem('lang') || 'es';
	applyLang(savedLang);

	themeOptions.forEach((button) => {
		button.addEventListener('click', () => {
			const nextTheme = button.getAttribute('data-theme') || 'light';
			applyTheme(nextTheme);
			localStorage.setItem('theme', nextTheme);
		});
	});

	langOptions.forEach((button) => {
		button.addEventListener('click', () => {
			const nextLang = button.getAttribute('data-lang') || 'es';
			applyLang(nextLang);
			localStorage.setItem('lang', nextLang);
		});
	});

	const sidebar = document.getElementById('site-sidebar');
	const toggleButton = document.getElementById('sidebar-toggle');
	const closeButton = document.getElementById('sidebar-close');
	const overlay = document.getElementById('sidebar-overlay');
	const sidebarLinks = document.querySelectorAll('#site-sidebar nav a');

	const setSidebarOpen = (open: boolean) => {
		if (!sidebar) return;
		sidebar.setAttribute('data-open', open ? 'true' : 'false');
		if (overlay) {
			overlay.classList.toggle('hidden', !open);
			overlay.setAttribute('aria-hidden', open ? 'false' : 'true');
		}
		if (toggleButton) {
			toggleButton.setAttribute('aria-expanded', open ? 'true' : 'false');
		}
		document.body.classList.toggle('overflow-hidden', open);
	};

	toggleButton?.addEventListener('click', () => setSidebarOpen(true));
	closeButton?.addEventListener('click', () => setSidebarOpen(false));
	overlay?.addEventListener('click', () => setSidebarOpen(false));

	sidebarLinks.forEach((link) => {
		link.addEventListener('click', () => {
			if (window.matchMedia('(max-width: 640px)').matches) {
				setSidebarOpen(false);
			}
		});
	});

	window.addEventListener('resize', () => {
		if (!window.matchMedia('(max-width: 640px)').matches) {
			setSidebarOpen(false);
		}
	});

	window.addEventListener('hashchange', setActiveFromHash);
	setActiveFromHash();
</script>
