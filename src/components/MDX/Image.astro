---
interface Props {
	label: string;
	alt: string;
	url: string;
	position:
		| 'top'
		| 'center'
		| 'bottom'
		| 'left'
		| 'right'
		| 'top-left'
		| 'top-right'
		| 'bottom-left'
		| 'bottom-right';
	offsetX?: string; // e.g. "10px" | "-1.5rem" | "5%"
	offsetY?: string; // e.g. "8px" | "-0.5rem" | "2%"
}

const {
	label = 'LOCATION: STUDIO',
	alt = 'Lugar de trabajo',
	url = 'https://i.etsystatic.com/30097568/r/il/71a49c/5958491123/il_1140xN.5958491123_lhzi.jpg',
	position = 'center',
	offsetX = '0px',
	offsetY = '0px'
} = Astro.props;

const positionClass = {
	top: 'object-top',
	center: 'object-center',
	bottom: 'object-bottom',
	left: 'object-left',
	right: 'object-right',
	'top-left': 'object-left-top',
	'top-right': 'object-right-top',
	'bottom-left': 'object-left-bottom',
	'bottom-right': 'object-right-bottom'
}[position];

const basePosition = {
	top: { x: '50%', y: '0%' },
	center: { x: '50%', y: '50%' },
	bottom: { x: '50%', y: '100%' },
	left: { x: '0%', y: '50%' },
	right: { x: '100%', y: '50%' },
	'top-left': { x: '0%', y: '0%' },
	'top-right': { x: '100%', y: '0%' },
	'bottom-left': { x: '0%', y: '100%' },
	'bottom-right': { x: '100%', y: '100%' }
}[position];

const objectPosition = `${basePosition.x ? `calc(${basePosition.x} + ${offsetX})` : basePosition.x} ${basePosition.y ? `calc(${basePosition.y} + ${offsetY})` : basePosition.y}`;
---

<div class="relative mb-4 w-full overflow-hidden border border-content/10 bg-content/5">
	<div class="absolute top-2 left-2 h-4 w-4 border-t border-l border-primary"></div>
	<div class="absolute top-2 right-2 h-4 w-4 border-t border-r border-primary"></div>
	<div class="absolute bottom-2 left-2 h-4 w-4 border-b border-l border-primary"></div>
	<div class="absolute right-2 bottom-2 h-4 w-4 border-r border-b border-primary"></div>

	<img
		src={url}
		alt={alt}
		style={`object-position: ${objectPosition};`}
		class={`aspect-21/9 h-auto w-full object-cover ${positionClass} opacity-90 transition-opacity duration-100 hover:opacity-100`}
	/>

	<div class="absolute right-4 bottom-4 bg-base/80 px-2 py-1 backdrop-blur-sm">
		<span class="font-mono text-[10px] tracking-[0.2em] text-primary uppercase">
			{label}
		</span>
	</div>
</div>
