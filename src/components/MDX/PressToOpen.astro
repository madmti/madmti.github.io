---
interface Item {
	key: string;
	label: string;
	href: string;
}

interface Props {
	items: Item[];
	sectionId?: string;
}

const { items, sectionId = 'contacto' } = Astro.props;
const listId = `press-to-open-${sectionId}`;
---

<ul id={listId} class="press-to-open flex flex-col gap-2" data-section-id={sectionId}>
	{
		items.map((item) => (
			<li>
				<a
					href={item.href}
					data-key={item.key.toLowerCase()}
					class="inline-flex items-center gap-3 hover:text-primary"
				>
					<span class="inline-flex h-6 w-6 items-center justify-center rounded border border-content/30 text-xs font-semibold">
						{item.key.toUpperCase()}
					</span>
					<span>{item.label}</span>
				</a>
			</li>
		))
	}
</ul>

<script define:vars={{ listId, sectionId }}>
	const list = document.getElementById(listId);
	if (!list) {
		throw new Error(`[PressToOpen] Missing list element: ${listId}`);
	}

	const keyMap = new Map();
	list.querySelectorAll('a[data-key]').forEach((anchor) => {
		const key = anchor.getAttribute('data-key');
		const href = anchor.getAttribute('href');
		if (key && href) {
			keyMap.set(key, href);
		}
	});

	let isActive = false;
	const section = document.getElementById(sectionId);
	if (section) {
		const observer = new IntersectionObserver(
			(entries) => {
				const [entry] = entries;
				isActive = Boolean(entry?.isIntersecting);
			},
			{
				root: null,
				rootMargin: '-20% 0px -70% 0px',
				threshold: [0, 0.25, 0.5, 0.75, 1]
			}
		);
		observer.observe(section);
	}

	window.addEventListener('keydown', (event) => {
		if (!isActive) return;
		if (event.defaultPrevented) return;
		if (event.metaKey || event.ctrlKey || event.altKey) return;

		const target = event.target;
		if (
			target instanceof HTMLElement &&
			(target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName))
		) {
			return;
		}

		const key = event.key.toLowerCase();
		const href = keyMap.get(key);
		if (!href) return;

		event.preventDefault();
		window.open(href, '_blank', 'noopener');
	});
</script>
