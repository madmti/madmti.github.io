---
import { getEntry } from 'astro:content';

const entry = await getEntry('academico', 'malla');
if (!entry) {
	throw new Error('No se encontró el entry academico/malla');
}

const { titulo, semestres, categorias } = entry.data;

const categoryClasses: Record<string, string> = {
	'Plan Común':
		'border-cyan-500/40 text-cyan-200 bg-cyan-950/20 light:border-cyan-500/40 light:text-cyan-900 light:bg-cyan-100/60',
	'Fundamentos de Informática':
		'border-blue-500/40 text-blue-200 bg-blue-950/20 light:border-blue-500/40 light:text-blue-900 light:bg-blue-100/60',
	'Ingeniería de Software':
		'border-yellow-500/40 text-yellow-200 bg-yellow-950/20 light:border-yellow-500/40 light:text-yellow-900 light:bg-yellow-100/70',
	'Infraestructura TIC':
		'border-purple-500/40 text-purple-200 bg-purple-950/20 light:border-purple-500/40 light:text-purple-900 light:bg-purple-100/70',
	'Humanistas, libres y deportes':
		'border-lime-500/40 text-lime-200 bg-lime-950/20 light:border-lime-500/40 light:text-lime-900 light:bg-lime-100/70',
	'Electivos Informática':
		'border-orange-500/40 text-orange-200 bg-orange-950/20 light:border-orange-500/40 light:text-orange-900 light:bg-orange-100/70',
	'Análisis Numérico':
		'border-emerald-500/40 text-emerald-200 bg-emerald-950/20 light:border-emerald-500/40 light:text-emerald-900 light:bg-emerald-100/70',
	Industrias:
		'border-sky-500/40 text-sky-200 bg-sky-950/20 light:border-sky-500/40 light:text-sky-900 light:bg-sky-100/70',
	'Sistemas de decisión informática':
		'border-red-500/40 text-red-200 bg-red-950/20 light:border-red-500/40 light:text-red-900 light:bg-red-100/70',
	'Transversal e Integración':
		'border-pink-500/40 text-pink-200 bg-pink-950/20 light:border-pink-500/40 light:text-pink-900 light:bg-pink-100/70'
};

const statusClasses: Record<string, string> = {
	aprobado: 'opacity-90',
	cursando: 'ring-1 ring-primary/40 light:ring-primary/30',
	pendiente: 'opacity-40 light:opacity-60'
};

const columns = semestres.length;
const minWidth = Math.max(columns * 140, 720);

const legendItems = categorias?.length
	? categorias
	: Array.from(
			new Set(semestres.flatMap((semestre) => semestre.ramos.map((ramo) => ramo.categoria)))
		).map((nombre) => ({ nombre }));
---

<section class="mt-8">
	<h3 class="mb-4 text-2xl font-bold tracking-tight text-primary uppercase">{titulo}</h3>

	<div class="overflow-x-auto rounded-md border border-content/10 bg-base/40 p-4 light:bg-base/80">
		<div style={`min-width: ${minWidth}px;`}>
			<div
				class="mb-4 grid gap-2 text-center font-mono text-[11px] text-content/60 light:text-content/80"
				style={`grid-template-columns: repeat(${columns}, minmax(0, 1fr));`}
			>
				{
					semestres.map((semestre) => (
						<div class="border-b border-content/10 pb-2 light:border-content/20">
							{semestre.label}
						</div>
					))
				}
			</div>

			<div class="grid gap-2" style={`grid-template-columns: repeat(${columns}, minmax(0, 1fr));`}>
				{
					semestres.map((semestre) => (
						<div class="flex flex-col gap-2">
							{semestre.ramos.map((ramo) => (
								<div
									class={`flex min-h-18 flex-col justify-between rounded-sm border p-2 text-[10px] leading-tight transition-all hover:brightness-110 light:hover:brightness-105 ${
										categoryClasses[ramo.categoria] ||
										'border-content/10 bg-content/5 text-content/70 light:border-content/20 light:bg-content/10 light:text-content/80'
									} ${statusClasses[ramo.estado || 'aprobado'] || ''}`}
								>
									<div class="flex items-start justify-between gap-2">
										<span class="font-bold opacity-80">{ramo.sigla}</span>
										<span class="rounded bg-black/40 px-1 light:bg-content/20 light:text-content/80">
											{ramo.creditos}
										</span>
									</div>
									<div class="text-[11px] font-medium tracking-tight uppercase">{ramo.nombre}</div>
								</div>
							))}
						</div>
					))
				}
			</div>
		</div>
	</div>

	{
		legendItems.length > 0 && (
			<div class="mt-4 flex flex-wrap gap-4 text-[10px] text-content/60 light:text-content/80">
				{legendItems.map((categoria) => (
					<div class="flex items-center gap-2">
						<span
							class={`h-3 w-3 rounded-sm border ${
								categoryClasses[categoria.nombre] || 'border-content/20 bg-content/10'
							}`}
						/>
						<span>{categoria.nombre}</span>
					</div>
				))}
			</div>
		)
	}
</section>
