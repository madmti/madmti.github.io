---
import Layout from '@/layouts/Layout.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';

const fullContent = {
	Biografia: await getCollection('biografia'),
	Proyectos: await getCollection('proyectos'),
	Blog: await getCollection('blog')
};
---

<Layout>
	<div>
		<Sidebar />
		<main>
			{
				Object.entries(fullContent).map(async ([name, sec]) => {
					return (
						<section id={name}>
							<h1>{name}</h1>
							{sec.map(async (art) => {
								const { Content } = await render(art);
								return (
									<section id={art.id}>
										<h2>{art.data.title}</h2>
										<div>
											<Content />
										</div>
									</section>
								);
							})}
						</section>
					);
				})
			}
		</main>
	</div>
</Layout>
