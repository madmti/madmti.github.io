---
import Layout from '@/layouts/Layout.astro';
import Sidebar from '@/components/Sidebar.astro';

// @ts-ignore
const fullContent = [];
---

<Layout>
	<div>
		<Sidebar />
		<main>
			{
				// @ts-ignore
				fullContent.map(async (entry) => {
					const { Content } = await entry.render();
					return (
						<section id={entry.slug}>
							<h2>{entry.data.title}</h2>
							<div>
								<Content />
							</div>
						</section>
					);
				})
			}
		</main>
	</div>
</Layout>
